programa patito;

vars i, j, k : entero;
vars f : flotante;

nula uno(a : entero, b : entero) {
    {
        si (a > 0) {
            i = a + b * j + i;
            escribe(i + i);
        } sino {
            escribe(a + b);
        };
    }
};

nula dos(a : entero, g : flotante) {
    vars ia : entero;

    {
        ia = a;

        mientras (a > 0) haz {
            a = a * k;
            uno(a * 2, a + k);
            g = g * j - k;
        };
    }
};

inicio {
    i = 2;
    k = i + 1;
    f = 3.14;

    mientras (i > 0) haz {
        dos(i + k, f * 3);
        escribe(i + j * 2, f * 2 + 1.5);
        i = i - k / 2;
    };
} fin